// Rent A Ride — Google keys for the iOS app.
//
// Copy this file to Secrets.xcconfig, then fill these in from your Google Cloud project (see docs/GOOGLE_SETUP.md).
// Keep this file private: do not share it or upload it to GitHub.
// Leave a value empty and the app shows "not set up yet" for that feature.

// Maps SDK for iOS API key (restrict it to bundle ID ng.rentaride.rentARidePassenger).
GOOGLE_MAPS_API_KEY =

// iOS OAuth client ID, e.g. 1234567890-abc123.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID =

// The same client ID reversed, e.g. com.googleusercontent.apps.1234567890-abc123
// (Google shows it as "iOS URL scheme").
GOOGLE_REVERSED_CLIENT_ID = ng.rentaride.google-not-configured
